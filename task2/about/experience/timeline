.timeline {
  position: relative;

  display: grid;
  gap: var(--space-5);

  padding-left: var(--space-6);
}

.timeline::before {
  content: "";

  position: absolute;
  left: 0.35rem;
  top: 0;
  bottom: 0;

  width: 2px;

  background: var(--color-border);
}

.timeline-item {
  position: relative;

  padding: var(--space-5);

  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);

  background: var(--color-surface);
}

.timeline-item::before {
  content: "";

  position: absolute;
  left: -2rem;
  top: 1.5rem;

  width: 0.75rem;
  aspect-ratio: 1;

  border: 3px solid var(--color-bg);
  border-radius: 50%;

  background: var(--color-primary);
}
